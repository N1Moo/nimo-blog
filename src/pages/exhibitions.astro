</html>

<style>
  :global(html),
  :global(body) {
    width: 100%;
    height: 100%;
    margin: 0;
    overflow: hidden;
    background: #141414;
    color: #bac4b8;
    font-family: Arial, sans-serif;
  }

  .exhibition-nav {
    position: fixed;
    top: 0;
    right: 0;
    left: 0;
    z-index: 10;
    box-sizing: border-box;
    height: 4rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 0 2.4rem;
    border-bottom: 1px solid rgba(186, 196, 184, 0.16);
    background: rgba(20, 20, 20, 0.9);
    backdrop-filter: blur(14px);
  }

  .exhibition-nav a {
    color: inherit;
    text-decoration: none;
  }

  .exhibition-nav__brand {
    flex: none;
    font-size: 1.08rem;
    font-weight: 700;
    line-height: 1;
  }

  .exhibition-nav__links {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.2vw, 2.25rem);
    font-size: 0.76rem;
  }

  .exhibition-nav__links a {
    position: relative;
    padding-block: 0.65rem;
    opacity: 0.68;
    transition: opacity 160ms ease;
  }

  .exhibition-nav__links a:hover,
  .exhibition-nav__links a:focus-visible,
  .exhibition-nav__links .is-active {
    opacity: 1;
  }

  .exhibition-nav__links .is-active::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: 0.35rem;
    left: 0;
    height: 1px;
    background: currentColor;
  }

  iframe {
    position: absolute;
    top: 4rem;
    left: 0;
    display: block;
    width: 100%;
    height: calc(100% - 4rem);
    border: 0;
    background: #141414;
  }

  @media (max-width: 700px) {
    .exhibition-nav {
      height: 3.5rem;
      gap: 1rem;
      padding-inline: 1rem;
    }

    .exhibition-nav__links {
      gap: 1rem;
      overflow-x: auto;
      font-size: 0.68rem;
      scrollbar-width: none;
    }

    .exhibition-nav__links::-webkit-scrollbar {
      display: none;
    }

    iframe {
      top: 3.5rem;
      height: calc(100% - 3.5rem);
    }
  }
</style>
