<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#141414" />
    <title>展览 | NIMO</title>
  </head>
  <body>
    <header class="exhibition-nav">
      <a class="exhibition-nav__brand" href="/">NIMO</a>

      <nav class="exhibition-nav__links" aria-label="站点导航">
        <a href="/">首页</a>
        <a class="is-active" href="/exhibitions" aria-current="page">展览</a>
        <a href="/articles">文章</a>
        <a href="/movies">观影</a>
        <a href="/books">读书</a>
        <a href="/about">关于</a>
      </nav>
    </header>

    <iframe
      src="/exhibition-clone.html?v=20260829-12works"
      title="NIMO 展览"
      loading="eager"
      allow="fullscreen"
    ></iframe>
