---
import Layout from "@/components/layout/Layout.astro";
import GitProjects from "@/components/GitProjects";
import { GitPlatform } from "@/lib/git-projects-shared";

export const prerender = true;
---

<Layout
  title="项目"
  description="我的开源项目展示"
  pageType="directory"
  skipSrTitle={false}
>
  <!-- 填入自己的代码托管账号后再启用项目列表。 -->
  <GitProjects
    platform={GitPlatform.GITHUB}
    username=""
    title="个人项目"
    showTitle={false}
    client:idle
  />
</Layout>
