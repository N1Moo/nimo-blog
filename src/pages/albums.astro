---
import Layout from "@/components/layout/Layout.astro";
import PhotoAlbumMasonry from "@/components/PhotoAlbumMasonry";

export const prerender = true;
---

<Layout
  title="相册"
  description="旅行和生活照片合集"
  pageType="directory"
  skipSrTitle={false}
>
  <!-- 填入自己的 Google Photos 分享 ID 后再启用相册。 -->
  <PhotoAlbumMasonry
    shareId=""
    title="生活碎片"
    showTitle={false}
    client:idle
  />
</Layout>
